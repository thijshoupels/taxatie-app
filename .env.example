# Kopieer dit bestand naar ".env" voor lokale ontwikkeling (npm run dev),
# en zet dezelfde sleutels in Vercel → Project Settings → Environment Variables
# voor de gehoste versie. Zie README.md voor uitleg waar je elke waarde vindt.

# Supabase → Project Settings → API → "Project URL"
VITE_SUPABASE_URL=

# Supabase → Project Settings → API → "anon public" key
VITE_SUPABASE_ANON_KEY=

# Google Cloud Console → "Maps Static API" inschakelen → Credentials → API-sleutel
# (optioneel: ontbreekt deze, dan blijft enkel de liggingskaart leeg, de rest werkt gewoon)
VITE_GOOGLE_MAPS_API_KEY=

# console.anthropic.com → API keys (blijft geheim, wordt NOOIT naar de browser gestuurd)
ANTHROPIC_API_KEY=
