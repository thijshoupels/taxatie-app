# Dummy waarden, enkel gebruikt tijdens "npm test" (Vitest) — geen echte sleutels. Nodig omdat
# src/App.jsx bij het inladen van de module meteen een Supabase-client aanmaakt
# (createClient(import.meta.env.VITE_SUPABASE_URL, ...)), wat zonder een geldig ogende URL al
# vóór de tests zelf zou falen. Er wordt tijdens de tests nergens écht mee verbonden.
VITE_SUPABASE_URL=https://test.supabase.co
VITE_SUPABASE_ANON_KEY=test-anon-key-niet-echt
